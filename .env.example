# ==============================================================================
# VirtualFit AI Environment Configuration
# Copy this file to .env and customize as needed. Never commit .env to source control!
# ==============================================================================

# Application Environment: 'development', 'production', or 'test'
ENVIRONMENT=development

# Host & Port for Backend API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin Dashboard Secret Token (Used for catalog management authentication)
# Set a strong random token in production!
ADMIN_API_KEY=virtualfit_admin_secret_key_change_me

# Try-On Provider Configuration
# Options: 'mock', 'hf_space', 'realtime_stub'
# In DEMO_MODE=true, the mock provider returns clearly watermarked "DEMO MODE — NOT AI" images.
DEMO_MODE=true
TRYON_PROVIDER=mock

# Hugging Face Space Configuration (Used only if TRYON_PROVIDER=hf_space)
# Note: yisol/IDM-VTON and zhengchong/CatVTON are under CC BY-NC-SA 4.0 (Non-Commercial Evaluation Only).
# Obtain your free HF personal access token from: https://huggingface.co/settings/tokens
HF_SPACE_ID=zhengchong/CatVTON
HF_API_TOKEN=

# Model Timeout in Seconds
TRYON_TIMEOUT_SECONDS=60

# Max Upload Size (Bytes) - Default 5 MB
MAX_UPLOAD_SIZE_BYTES=5242880

# Storage Directories
DATABASE_PATH=data/virtualfit.db
UPLOAD_DIR=data/uploads
TEMP_DIR=data/temp
